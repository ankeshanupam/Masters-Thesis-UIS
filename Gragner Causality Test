def grangers_causation_matrix(series1, series2, maxlag=1, alpha=0.05):
    """
    series1: pandas Series (dependent / affected variable)
    series2: pandas Series (potential cause)
    maxlag: maximum lag to test
    alpha: significance level for pass/fail
    """

    # 1. Align the two series on their index and drop any NaNs
    df = pd.concat([series1, series2], axis=1)
    df.columns = ['y', 'x']          # y_t, x_t
    df = df.dropna()

    n_obs = len(df)
    print(f"\nGranger Causality Matrix (n_obs={n_obs}):")
    print('Null Hypothesis: x does NOT Granger-cause y')          
    print('Alternative Hypothesis: x DOES Granger-cause y')

    # 2. Check you have enough observations for the requested maxlag
    #    statsmodels roughly requires: n_obs > 3 * maxlag + 1
    if n_obs <= 3 * maxlag + 1:
        print(f"Not enough observations for maxlag={maxlag}. "
              f"Need > {3 * maxlag + 1}, have {n_obs}. Skipping.")
        return None

    # 3. Build data with shape (n_obs, 2) as required
    data = df.values  # each row: [y_t, x_t]

    # 4. Run test
    test_result = grangercausalitytests(data, maxlag=maxlag, verbose=False)

    # 5. Collect p-values for each lag (using ssr_ftest)
    p_values = [
        round(test_result[lag][0]['ssr_ftest'][1], 4)
        for lag in range(1, maxlag + 1)
    ]
    min_p_value = float(np.min(p_values))

    print("Granger Causality - p-values (Lower is better):", p_values)
    print("Minimum p-value:", min_p_value)

    if min_p_value < alpha:
        print(f"Granger Causality Test PASSED at alpha={alpha} (reject H0)")
    else:
        print(f"Granger Causality Test FAILED at alpha={alpha} (cannot reject H0)")

    return {
        "n_obs": n_obs,
        "maxlag_used": maxlag,
        "p_values": p_values,
        "min_p_value": min_p_value,
    }
